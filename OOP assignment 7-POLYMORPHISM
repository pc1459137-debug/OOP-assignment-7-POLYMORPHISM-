//Write a C++ program to demonstrate compile-time and run-time polymorphism using function overloading, inheritance, function overriding, and virtual functions.


#include <iostream>
using namespace std;

// Compile-time polymorphism
class Calculator {
public:
    int add(int a, int b) {
        return a + b;
    }

    int add(int a, int b, int c) {
        return a + b + c;
    }

    float add(float a, float b) {
        return a + b;
    }
};

// Run-time polymorphism
class Animal {
public:
    virtual void sound() {
        cout << "Animal makes a sound." << endl;
    }
};

class Dog : public Animal {
public:
    void sound() override {
        cout << "Dog barks." << endl;
    }
};

class Cat : public Animal {
public:
    void sound() override {
        cout << "Cat meows." << endl;
    }
};

int main() {
    Calculator c;

    cout << "Compile-time Polymorphism:" << endl;
    cout << "Addition of 2 integers: "
         << c.add(10, 20) << endl;
    cout << "Addition of 3 integers: "
         << c.add(10, 20, 30) << endl;
    cout << "Addition of 2 floats: "
         << c.add(2.5f, 3.5f) << endl;

    cout << "\nRun-time Polymorphism:" << endl;

    Animal* ptr;
    Dog d;
    Cat cat;

    ptr = &d;
    ptr->sound();

    ptr = &cat;
    ptr->sound();

    return 0;
}
